/*
 * Wi-Fi 認証情報のテンプレート。
 *
 * このファイルを **secrets.h という名前でコピー**して、実際の値を入れること:
 *
 *     copy secrets.h.example secrets.h      (Windows)
 *     cp   secrets.h.example secrets.h      (Linux / macOS)
 *
 * secrets.h は .gitignore 済みなのでコミットされない。
 * 逆に、このテンプレート (secrets.h.example) には**実際の値を書かないこと**。
 *
 * Arduino IDE ではスケッチフォルダ内のヘッダが自動でタブとして開く。
 * PlatformIO では src_dir = . なのでそのまま見つかる。
 */
#pragma once

const char* WIFI_SSID     = "your_wifi_ssid";
const char* WIFI_PASSWORD = "your_wifi_password";
