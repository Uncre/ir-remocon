# Python / uv
.venv/
__pycache__/
*.py[cod]
.pytest_cache/

# ログ (RotatingFileHandler が生成)
*.log
*.log.*

# SQLite の WAL / 共有メモリ 
*.db-wal
*.db-shm

# DB 本体
*.db

# 移行ツールが作るバックアップ
*.bak
backup_before_refactor/

# PlatformIO のビルド成果物 (ツールチェインは ~/.platformio 側にある)
esp/**/.pio/
esp/**/.vscode/

# ファームの Wi-Fi 認証情報。secrets.h.example は追跡対象のまま残すこと
esp/**/secrets.h
